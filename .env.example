# ─── MQTT (HiveMQ Cloud) ─────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# .env is git-ignored and must NEVER be committed.

MQTT_BROKER=your-cluster.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=your-username
MQTT_PASSWORD=your-password
MQTT_CLIENT_ID=mpv-relay-server

# ─── Topics ──────────────────────────────────────────────────────────────────
MQTT_TOPIC_CMD=mpv/command
MQTT_TOPIC_STATUS=mpv/status

# ─── MPV ─────────────────────────────────────────────────────────────────────
MPV_SOCKET=/tmp/mpvsocket

# ─── WebSocket ───────────────────────────────────────────────────────────────
WS_ADDR=:9000

# ─── Local cache ─────────────────────────────────────────────────────────────
MUSIC_CACHE_DIR=~/mpv-relay/media
DB_PATH=~/mpv-relay/data/relay.db
LOG_PATH=~/mpv-relay/logs/relay.log

# ─── yt-dlp binary (optional — falls back to PATH) ───────────────────────────
# YTDLP_BIN=/usr/local/bin/yt-dlp
